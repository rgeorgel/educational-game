# Copie para .env e ajuste os valores:  cp .env.example .env

# ---------- Banco de dados ----------
# LOCAL (desenvolvimento): o Postgres roda num container, ativado pelo perfil abaixo.
# NO SERVIDOR (banco fora do Docker): apague ou comente esta linha.
COMPOSE_PROFILES=local-db

# Dados de acesso ao banco. Os valores abaixo são os do banco local (container "db").
# No servidor, troque pelos dados do seu Postgres:
#   DB_HOST=host.docker.internal   → Postgres instalado no próprio servidor
#   DB_HOST=ip-ou-nome-da-maquina  → Postgres em outra máquina
DB_HOST=db
DB_PORT=5432
DB_NAME=edugame
DB_USER=edugame
DB_PASSWORD=troque-esta-senha

# Opcionais
DB_SSL_MODE=Prefer             # Disable, Prefer, Require, VerifyCA ou VerifyFull
DB_MIGRATE_ON_STARTUP=true     # aplica as migrations ao iniciar a API
DB_LOCAL_PORT=5433             # (só local) porta do banco no seu computador

# ---------- Aplicação ----------
WEB_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
