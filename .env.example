# Copie para .env e ajuste os valores:  cp .env.example .env

# ---------- Banco de dados ----------
# LOCAL (desenvolvimento): Postgres num container, ativado pelo perfil abaixo.
COMPOSE_PROFILES=local-db
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5433

# SERVIDOR (banco fora do Docker): apague/comente COMPOSE_PROFILES acima e defina a conexão.
# Postgres no próprio servidor:  Host=host.docker.internal
# Postgres em outra máquina:     Host=ip-ou-nome-do-servidor
# DATABASE_CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=edugame;Username=edugame;Password=senha;SSL Mode=Prefer
# Aplicar migrations automaticamente ao iniciar a API (o usuário do banco precisa poder criar tabelas):
# DATABASE_MIGRATE_ON_STARTUP=true

# ---------- Aplicação ----------
WEB_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
