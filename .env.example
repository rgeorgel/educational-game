# Copie para .env e ajuste os valores:  cp .env.example .env

# ---------- Banco de dados ----------
# LOCAL (desenvolvimento): o Postgres roda num container, ativado pelo perfil abaixo.
# NO SERVIDOR (banco fora do Docker): apague ou comente esta linha.
COMPOSE_PROFILES=local-db

# Dados de acesso ao banco. Os valores abaixo são os do banco local (container "db").
# No servidor, troque pelos dados do seu Postgres:
#   DB_HOST=host.docker.internal   → Postgres instalado no próprio servidor
#   DB_HOST=ip-ou-nome-da-maquina  → Postgres em outra máquina
DB_HOST=db
DB_PORT=5432
DB_NAME=edugame
DB_USER=edugame
DB_PASSWORD=troque-esta-senha

# Opcionais
DB_SSL_MODE=Prefer             # Disable, Prefer, Require, VerifyCA ou VerifyFull
DB_MIGRATE_ON_STARTUP=true     # aplica as migrations ao iniciar a API
DB_LOCAL_PORT=5433             # (só local) porta do banco no seu computador

# ---------- Aplicação ----------
WEB_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# ---------- Planos (professores e escolas) ----------
# false (padrão): todos têm os recursos do Professor Pro e da Família; escolher um plano só fica registrado.
# true: cada conta tem só o que os seus planos liberam (Grátis: 3 perfis, 1 turma, 2 tarefas, sem planilha,
# sem fichas, sem relatório da semana e sem reforço). Veja docs/MONETIZACAO.md.
PLANS_ENFORCE=false

# ---------- Pagamentos (Stripe) ----------
# Deixe vazio para continuar no modo lançamento (escolha de plano sem cobrança).
# Use as chaves de TESTE (sk_test_...) até validar tudo. Com a chave e o PUBLIC_BASE_URL, rode
# "dotnet EduGame.Api.dll stripe configurar": ele cria produtos, preços, webhook e portal e mostra o whsec_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=         # o whsec_... mostrado por "stripe configurar"
PUBLIC_BASE_URL=               # ex.: https://educa-game.seu-dominio (sem barra no final)
# Opcional: forçar um preço específico (sem isso, o app acha o preço pelo nome fixo).
# STRIPE_PRICE_PROFESSOR=
# STRIPE_PRICE_FAMILIA=

# ---------- E-mails (recuperação de senha, boas-vindas, aviso de senha alterada) ----------
# Qualquer provedor SMTP serve (Resend, Postmark, Brevo, Amazon SES, Gmail…). Também precisa do PUBLIC_BASE_URL
# acima (os links dos e-mails usam ele). Sem SMTP: em desenvolvimento o e-mail aparece no log da API;
# em produção, "Esqueci minha senha" responde que está indisponível.
SMTP_HOST=                     # ex.: smtp.resend.com
SMTP_PORT=587                  # 587 = STARTTLS, 465 = SSL
SMTP_USER=                     # ex.: resend
SMTP_PASSWORD=
EMAIL_FROM=                    # ex.: Educa Game <nao-responda@seu-dominio>  (domínio verificado no provedor)
EMAIL_REPLY_TO=                # opcional: e-mail de suporte que recebe as respostas

# ---------- Painel de super admin (serviço edugame-admin) ----------
# Sem usuário e senha o painel fica bloqueado. A senha precisa ter pelo menos 12 caracteres.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PORT=8081                # http://localhost:8081
ADMIN_BIND=127.0.0.1           # 127.0.0.1 = só neste computador; 0.0.0.0 = aberto na rede (use HTTPS!)
# Opcional (recomendado no servidor): usuário do Postgres só com permissão de leitura.
# Sem eles o painel usa DB_USER/DB_PASSWORD (a conexão do painel já abre em modo somente leitura).
# ADMIN_DB_USER=edugame_leitura
# ADMIN_DB_PASSWORD=
