<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Curated\*.json" />
    <!-- WithCulture=false: os arquivos .en.json/.es.json ficam neste assembly (e não num assembly satélite). -->
    <EmbeddedResource Include="Curated\i18n\*.json" WithCulture="false" />
  </ItemGroup>

</Project>
